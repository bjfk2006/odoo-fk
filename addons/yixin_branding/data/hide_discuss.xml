<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Hide the Discuss app from the navigation (mail stays installed; only
         the top-level menu is deactivated). -->
    <record id="mail.menu_root_discuss" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <!-- Hide the "Apps" (应用) module-management menu. -->
    <record id="base.menu_management" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
</odoo>
