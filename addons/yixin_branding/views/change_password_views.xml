<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Change Password wizard: add a placeholder so the input box is obvious. -->
    <record id="change_password_user_tree_yixin" model="ir.ui.view">
        <field name="name">change.password.user.tree.yixin</field>
        <field name="model">change.password.user</field>
        <field name="inherit_id" ref="base.change_password_wizard_user_tree_view"/>
        <field name="arch" type="xml">
            <field name="new_passwd" position="attributes">
                <attribute name="placeholder">请在此输入新密码</attribute>
            </field>
        </field>
    </record>

    <!-- Add a short instruction above the user list. -->
    <record id="change_password_wizard_yixin" model="ir.ui.view">
        <field name="name">change.password.wizard.yixin</field>
        <field name="model">change.password.wizard</field>
        <field name="inherit_id" ref="base.change_password_wizard_view"/>
        <field name="arch" type="xml">
            <field name="user_ids" position="before">
                <div class="alert alert-info mb-3" role="alert">
                    在下方「新密码」栏为用户输入新密码，然后点「修改密码」保存即可（无需发送邮件）。
                </div>
            </field>
        </field>
    </record>

</odoo>
