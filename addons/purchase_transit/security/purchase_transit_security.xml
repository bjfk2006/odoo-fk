<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>

    <record model="res.groups.privilege" id="res_groups_privilege_purchase_transit">
        <field name="name">Transit Tracking</field>
        <field name="sequence">25</field>
        <field name="category_id" ref="base.module_category_supply_chain"/>
    </record>

    <record id="group_transit_user" model="res.groups">
        <field name="name">Logistics Officer</field>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="privilege_id" ref="res_groups_privilege_purchase_transit"/>
    </record>

    <record id="group_transit_manager" model="res.groups">
        <field name="name">Logistics Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_purchase_transit"/>
        <field name="implied_ids" eval="[(4, ref('group_transit_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

</data>
</odoo>
