<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_transit" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.transit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <block name="purchase_setting_container" position="inside">
                <setting id="transit_auto_generate" string="Transit Tracking"
                         help="Automatically create transit tracking records when a purchase order is confirmed">
                    <field name="transit_auto_generate_on_confirm"/>
                </setting>
            </block>
        </field>
    </record>

</odoo>
