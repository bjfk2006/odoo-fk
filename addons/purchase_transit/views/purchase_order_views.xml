<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="purchase_order_view_form_transit" model="ir.ui.view">
        <field name="name">purchase.order.form.transit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <!-- Smart button: jump to this PO's transit records -->
            <div name="button_box" position="inside">
                <button name="action_view_transit" type="object"
                        class="oe_stat_button" icon="fa-ship"
                        invisible="state in ('draft', 'sent', 'cancel')">
                    <field name="transit_count" widget="statinfo" string="Transit"/>
                </button>
            </div>
            <!-- Header action: generate transit records on demand -->
            <button name="button_confirm" position="after">
                <button name="action_generate_transit" type="object"
                        string="Generate Transit Tracking"
                        invisible="state in ('draft', 'sent', 'cancel')"
                        groups="purchase_transit.group_transit_user"/>
            </button>
        </field>
    </record>

</odoo>
